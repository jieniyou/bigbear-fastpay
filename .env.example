# FastPay Docker Compose 部署变量示例
# 复制为 .env 后，只需要按服务器端口和强密码修改。

MYSQL_ROOT_PASSWORD=change_this_mysql_root_password
# 初始化脚本默认创建 bigbear_fastpay；如需改库名，请同步修改 init.sql。
MYSQL_DATABASE=bigbear_fastpay
MYSQL_USER=fastpay
MYSQL_PASSWORD=change_this_mysql_password

# 对外只暴露网关端口，后端/管理端/商户端均走 Docker 内网。
GATEWAY_HTTP_PORT=80
# GitHub Actions 构建并推送到 GHCR 的镜像前缀。
FASTPAY_IMAGE_PREFIX=ghcr.io/jieniyou/bigbear-fastpay
FASTPAY_IMAGE_TAG=latest


FASTPAY_JWT_SECRET=change_this_jwt_secret_at_least_32_chars
FASTPAY_JWT_EXPIRE_HOURS=12
FASTPAY_ADMIN_INIT_ENABLED=true
FASTPAY_ADMIN_USERNAME=fastpay_admin
FASTPAY_ADMIN_PASSWORD=change_this_initial_admin_password_12_chars_min

FASTPAY_ORDER_TIMEOUT_MINUTES=3
FASTPAY_API_INFO_ENABLED=false
KNIFE4J_ENABLED=false
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
